<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="SAPB1" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EnumType Name="BoStatus">
        <Member Name="bost_Open" Value="0"/>
        <Member Name="bost_Close" Value="1"/>
      </EnumType>

      <ComplexType Name="DocumentLine">
        <Property Name="LineNum" Type="Edm.Int32"/>
        <Property Name="ItemCode" Type="Edm.String"/>
        <Property Name="Quantity" Type="Edm.Double"/>
        <!-- Pooled lookups disagree on this name (Currency vs FakeCurrency) -> no inference. -->
        <Property Name="Currency" Type="Edm.String"/>
      </ComplexType>

      <EntityType Name="Document">
        <Key>
          <PropertyRef Name="DocEntry"/>
        </Key>
        <Property Name="DocEntry" Type="Edm.Int32" Nullable="false"/>
        <Property Name="CardCode" Type="Edm.String"/>
        <Property Name="DocumentStatus" Type="SAPB1.BoStatus"/>
        <Property Name="DocumentLines" Type="Collection(SAPB1.DocumentLine)"/>
        <NavigationProperty Name="BusinessPartner" Type="SAPB1.BusinessPartner">
          <ReferentialConstraint Property="CardCode" ReferencedProperty="CardCode"/>
        </NavigationProperty>
      </EntityType>

      <EntityType Name="BusinessPartner">
        <Key>
          <PropertyRef Name="CardCode"/>
        </Key>
        <Property Name="CardCode" Type="Edm.String" Nullable="false"/>
        <Property Name="CardName" Type="Edm.String"/>
        <!-- Property-typed Collection of an addressable EntityType: must NOT become an owned section. -->
        <Property Name="RelatedQuotations" Type="Collection(SAPB1.Document)"/>
        <!-- Reverse entity-set NavigationProperty: also must NOT become an owned collection section. -->
        <NavigationProperty Name="Quotations" Type="Collection(SAPB1.Document)"/>
      </EntityType>

      <EntityType Name="Item">
        <Key>
          <PropertyRef Name="ItemCode"/>
        </Key>
        <Property Name="ItemCode" Type="Edm.String" Nullable="false"/>
        <Property Name="ItemName" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="Currency">
        <Key>
          <PropertyRef Name="Code"/>
        </Key>
        <Property Name="Code" Type="Edm.String" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
      </EntityType>

      <!-- ComplexTypes carry no NavigationProperty, so DocumentLine.ItemCode can only inherit a
           lookup from a same-named constraint on an addressable type. This is that type. -->
      <EntityType Name="SpecialPrice">
        <Key>
          <PropertyRef Name="AbsEntry"/>
        </Key>
        <Property Name="AbsEntry" Type="Edm.Int32" Nullable="false"/>
        <Property Name="ItemCode" Type="Edm.String"/>
        <Property Name="Currency" Type="Edm.String"/>
        <NavigationProperty Name="Item" Type="SAPB1.Item">
          <ReferentialConstraint Property="ItemCode" ReferencedProperty="ItemCode"/>
        </NavigationProperty>
        <NavigationProperty Name="Cur" Type="SAPB1.Currency">
          <ReferentialConstraint Property="Currency" ReferencedProperty="Code"/>
        </NavigationProperty>
      </EntityType>

      <!-- Second, conflicting Currency constraint: the pooled name must be dropped, while
           SpecialPrices keeps its own precise one. -->
      <EntityType Name="FakeCurrency">
        <Key>
          <PropertyRef Name="Code"/>
        </Key>
        <Property Name="Code" Type="Edm.String" Nullable="false"/>
      </EntityType>

      <EntityType Name="PriceRow">
        <Key>
          <PropertyRef Name="AbsEntry"/>
        </Key>
        <Property Name="AbsEntry" Type="Edm.Int32" Nullable="false"/>
        <Property Name="Currency" Type="Edm.String"/>
        <NavigationProperty Name="Cur" Type="SAPB1.FakeCurrency">
          <ReferentialConstraint Property="Currency" ReferencedProperty="Code"/>
        </NavigationProperty>
      </EntityType>

      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Quotations" EntityType="SAPB1.Document"/>
        <EntitySet Name="BusinessPartners" EntityType="SAPB1.BusinessPartner"/>
        <EntitySet Name="Items" EntityType="SAPB1.Item"/>
        <EntitySet Name="Currencies" EntityType="SAPB1.Currency"/>
        <EntitySet Name="FakeCurrencies" EntityType="SAPB1.FakeCurrency"/>
        <EntitySet Name="SpecialPrices" EntityType="SAPB1.SpecialPrice"/>
        <EntitySet Name="PriceRows" EntityType="SAPB1.PriceRow"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
