# HTTP port the MCP server listens on. Default: 3000
PORT=3000

# TLS / HTTPS configuration
# Enable HTTPS. Default: true
# When true, the server uses TLS and requires HTTPS_KEY_PATH and HTTPS_CERT_PATH to be set.
# Set to false when the server runs behind a TLS-terminating reverse proxy, or you just want to use HTTP.
HTTPS_ENABLED=true

# Path to the PEM-encoded TLS private key file. Default: ./certs/server.key
HTTPS_KEY_PATH=./certs/server.key

# Path to the PEM-encoded TLS certificate file (may include the full chain). Default: ./certs/server.crt
HTTPS_CERT_PATH=./certs/server.crt

# Path to the PEM-encoded CA certificate file used to verify client certificates. Optional.
# Leave empty if client certificate authentication is not required.
# HTTPS_CA_PATH=./certs/ca.crt

# Passphrase for the TLS private key, if the key file is encrypted. Optional.
# Leave empty if the key is not passphrase-protected.
# HTTPS_PASSPHRASE=

# SAP Business One Service Layer (Direct Mode)
# Copy the contents into your project's .env file and adjust values
# Company and credentials (use only for local/dev)
# B1_COMPANY_DB=SBODEMOUS
# B1_USERNAME=manager
# B1_PASSWORD=manager

# Base URL of the OAuth 2.0 / OIDC authorization server (e.g. Keycloak realm URL).
# Used to derive token, introspection, and JWKS endpoints.
# For example: https://keycloak.b1.example.com/auth/realms/sapb1
OAUTH_BASE_URL=

# Root URL of the B1 System Landscape Directory (SLD) service.
# For example: https://sld.b1.example.com:40000
SLD_ROOT_URL=

# Root URL of the SAP Business One Service Layer OData API.
# All OData requests are routed through this URL.
# For example: https://servicelayer.b1.example.com:50000
SERVICE_LAYER_ROOT_URL=

# OAuth client ID for this MCP server
# For example: your-mcp-server-client-id
OAUTH_CLIENT_ID=

# OAuth client credentials for this MCP server
OAUTH_CLIENT_SECRET=

# Determine whether to allow introspection against servers with self-signed certs. Default: false
# WARNING: Do NOT enable in production. Prefer using a valid CA or set NODE_EXTRA_CA_CERTS.
AUTH_ALLOW_SELF_SIGNED=false

# How long (in minutes) to cache the company list fetched from SLD. Default: 5 minutes
# Increase to reduce SLD load; decrease to pick up newly added companies faster.
COMPANY_LIST_CACHE_TTL_MINUTES=5

# How long (in minutes) to cache SAP B1 OData metadata fetched from the Service Layer. Default: 30
# Covers both the entity list (fetched on session init) and per-entity schemas (fetched on demand).
# Increase to reduce Service Layer load; decrease to pick up schema changes (e.g. UDFs, UDOs) faster.
# Must be a positive integer. Invalid or non-positive values fall back to the default.
METADATA_CACHE_TTL_MINUTES=30

# Authentication mode. Default: oauth
#   oauth   — validate incoming requests via OAuth 2.0 / OIDC (requires OAUTH_BASE_URL and OAUTH_CLIENT_ID)
#   direct  — use SAP B1 credentials directly (requires B1_COMPANY_DB, B1_USERNAME, B1_PASSWORD)
AUTHENTICATION_MODE=oauth

# Node.js runtime environment. Affects error verbosity and certain framework behaviours. Default: production
#   development — verbose errors, relaxed security defaults
#   production  — minimal error exposure, stricter defaults
NODE_ENV=production

# Maximum allowed size for incoming request bodies (e.g. 1mb, 512kb, 5mb). Default: 1mb
# Increase if MCP tool payloads are large; keep small to limit memory use and mitigate DoS risk.
REQUEST_BODY_LIMIT=1mb

# Comma-separated list of host names the MCP server accepts in the HTTP Host header. Default: 127.0.0.1,localhost
# Used for DNS rebinding protection: requests whose Host header does not match this list are rejected.
# Add any hostname through which the server is reachable (e.g. a reverse-proxy DNS name or container hostname).
# Example: MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.internal.company.com
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Public base URL the server uses when advertising its own OAuth and MCP metadata endpoints.
# Leave unset for local development — the server will derive the URL from the active listener.
# Set this when the server runs behind a reverse proxy or is deployed at a public hostname,
# so that the advertised URLs point to the correct external address.
# Example: MCP_BASE_URL=https://mcp.example.com
# MCP_BASE_URL=

# Comma-separated list of origins allowed to make cross-origin requests (CORS). Default: (empty — CORS disabled)
# Use * to allow all origins (not recommended for production).
# Example: CORS_ALLOWED_ORIGINS=https://app.company.com,https://admin.company.com
CORS_ALLOWED_ORIGINS=

# How long (in minutes) a MCP session may be idle before it is automatically expired. Default: 30
# A session is considered idle when no tool calls or messages have been received within this window.
# Expired sessions are cleaned up and an audit event (SessionExpired) is recorded.
# Must be a positive integer. Has no effect on SAP B1 Service Layer login sessions.
SESSION_TIMEOUT_MINUTES=30

# Time window (in minutes) for rate limiting. Default: 1
# Requests exceeding MCP_RATE_LIMIT_MAX within this window are rejected with HTTP 429.
# Must be a positive integer.
MCP_RATE_LIMIT_WINDOW_MINUTES=1

# Maximum number of requests allowed per client within the rate limit window. Default: 120
MCP_RATE_LIMIT_MAX=120

# Require user confirmation before executing write operations (POST/PATCH/DELETE). Default: true
# When true, the MCP client is prompted to confirm destructive or mutating tool calls via elicitation.
# Set to false to disable confirmation prompts (e.g. in automated/non-interactive flows).
MCP_HUMAN_CONFIRMATION_ENABLED=true

# Comma-separated list of OAuth scopes required on incoming access tokens. Default: b1_mcp:access
# Tokens that do not include all listed scopes are rejected with HTTP 401.
# Example: OAUTH_REQUIRED_SCOPES=b1_mcp:access
OAUTH_REQUIRED_SCOPES=b1_mcp:access

# Whether to verify OAuth scopes on incoming access tokens. Default: true
# Set to false to disable scope verification (e.g. during development or when the AS cannot issue scoped tokens).
OAUTH_VERIFY_SCOPES=true

# Validate the audience claim (aud) in access tokens.
# Default: true
# When true, the token must include this MCP server's URL or OAuth client ID in its audience.
# Set to false only if your OAuth provider cannot issue audience-restricted tokens.
# WARNING: Disabling audience validation allows tokens issued for other services to be accepted.
VALIDATE_AUDIENCE=true

# Token validation mode — controls how the server verifies incoming access tokens.
#
#   introspection-with-jwt-fallback  (default)
#     Calls the AS introspection endpoint first. Falls back to local JWT signature
#     verification only when the AS is unreachable (network error, timeout, 5xx).
#     Best balance of security and availability.
#
#   introspection
#     Remote introspection only. Fails closed if the AS is unreachable.
#     Use in regulated/high-security environments where revocation must always be checked.
#
#   jwt
#     Local JWT signature verification only. No revocation check — a revoked token
#     remains valid until it expires. Safe only with short-lived tokens (exp < 5 min).
#     Use for high-throughput internal services where AS round-trips are unacceptable.
#
TOKEN_VALIDATION_MODE=introspection

# Enable audit log file output. Default: true
# Set to false to disable file output and log to console only.
# Configure the file path and rotation policy with AUDIT_LOG_FILE_PATH, AUDIT_LOG_MAX_SIZE_BYTES,
# AUDIT_LOG_RETENTION_DAYS, AUDIT_LOG_ZIPPED_ARCHIVE, AUDIT_LOG_CREATE_SYMLINK, AUDIT_LOG_SYMLINK_NAME.
AUDIT_LOG_FILE_ENABLED=true

# Enable audit log console output. Default: false
AUDIT_LOG_CONSOLE_ENABLED=false

# Maximum size of each audit log file in bytes before rotation. Default: 10485760 (10 MB)
AUDIT_LOG_MAX_SIZE_BYTES=10485760

# Number of days to retain rotated audit log files. Default: 365
AUDIT_LOG_RETENTION_DAYS=365

# Application log verbosity level. Default: info
# Levels (least to most verbose): error | warn | info | debug
# Use debug in development to trace request handling and app logic.
# Use info or warn in production to reduce log volume.
APP_LOG_LEVEL=info

# Enable application log file output. Default: true
# Set to false to disable file output and log to console only.
APP_LOG_FILE_ENABLED=true

# Enable application log console output. Default: false
APP_LOG_CONSOLE_ENABLED=false

# Maximum size of each application log file in bytes before rotation. Default: 10485760 (10 MB)
APP_LOG_MAX_SIZE_BYTES=10485760

# Number of days to retain rotated application log files. Default: 90
APP_LOG_RETENTION_DAYS=90

# ─── Integration tests ───────────────────────────────────────────────────────
# OAuth client ID used by integration tests (must have Authorization Code + PKCE
# enabled in Keycloak and http://127.0.0.1:*/callback as an allowed redirect URI).
TEST_MCP_CLIENT_ID=my-mcp-client

# Space-separated OAuth scopes requested during integration tests.
TEST_OAUTH_SCOPES=email b1_mcp:access profile

# Set true to trigger a browser-based OAuth PKCE flow when running integration tests.
TEST_OAUTH_INTERACTIVE=true
