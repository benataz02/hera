{
  "name": "b1-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for SAP Business One Service Layer OData services",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.9.8"
  },
  "scripts": {
    "build": "tsc && npm run copy-static",
    "test": "npm run \"test:unit\"",
    "test:unit": "vitest run src/tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --pool=forks src/tests/integration",
    "copy-static": "node -e \"const fs=require('fs'); const path=require('path'); const src='src/public'; const dest='dist/public'; fs.mkdirSync(dest,{recursive:true}); if (fs.existsSync(src)) { fs.cpSync(src, dest, {recursive:true}); console.log('Static files copied'); } else { console.log('No static files to copy'); }\"",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist node_modules/.cache",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "simple-mcp-client": "jiti src/sample/simple-mcp-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.2.0",
    "jose": "^6.1.0",
    "jsdom": "^29.1.1",
    "undici": "^7.24.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.x",
    "@types/supertest": "^6.0.3",
    "@xmldom/xmldom": "^0.9.9",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.8"
  }
}
